// 세이린뷰티 — 다이아 '참여 링크' 파이어베이스 파이어스토어 보안 규칙 (2026-11-24 커비)
// 무료 Spark 요금제: 함수(Cloud Functions)·유료 백엔드 없이 이 규칙만으로 읽기·쓰기를 처리합니다.
// 호스팅은 지금처럼 GitHub Pages 를 쓰고, 파이어스토어는 데이터 저장·조회에만 씁니다.
//
//  · links  : 그날 참여 링크. 누구나 읽기 / 쓰기는 아래 확인을 거쳐야 함
//  · pins   : 회원 4자리 암호. 읽기 금지 — 규칙 안에서만 봅니다(화면에 절대 안 나옴)
//  · checks : 암호 확인용 문서. 링크 쓰기와 같은 묶음으로 만들고, 끝나면 바로 지웁니다. 읽기 금지
//  · pinchk : 스태프가 암호를 바꾸거나 비울 때 쓰는 확인용 문서. 읽기 금지
//
//  남기는 시간: 한국 낮 09:00 ~ 밤 21:00 = 세계표준시(UTC) 00:00 ~ 12:00
//  같은 날 같은 게시물 주소는 문서 번호(links/날짜_주소해시)가 같아서 저절로 막힙니다.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 남기는 시간 제한 해제 (24시간 상시 가능)
    function openNow() {
      return true;
    }

    // ── 본인 4자리 암호 확인
    //    닉네임에 든 '/'는 문서 경로에 쓸 수 없어 '|'로 바꾼다 (dia-fb.js 의 safeId 와 같은 규칙)
    function pinOk(shop, pin) {
      let sid = shop.replace('/', '|');
      let p = /databases/$(database)/documents/pins/$(sid);
      return exists(p) && get(p).data.pin == pin;
    }

    // ── 확인용 문서(checks)가 같은 묶음으로 만들어졌는지 확인
    function chkOk(cid, id, shop) {
      return getAfter(/databases/$(database)/documents/checks/$(cid)).data.id == id
          && getAfter(/databases/$(database)/documents/checks/$(cid)).data.shop == shop
          && (getAfter(/databases/$(database)/documents/checks/$(cid)).data.op == 'write'
              || getAfter(/databases/$(database)/documents/checks/$(cid)).data.op == 'del');
    }
    function chkStaff(cid, id) {
      return getAfter(/databases/$(database)/documents/checks/$(cid)).data.id == id
          && getAfter(/databases/$(database)/documents/checks/$(cid)).data.op == 'staff';
    }

    // ── 링크 문서 모양 (지시받지 않은 칸이 붙는 것을 막는다)
    function itemOk(d, lid) {
      return d.keys().hasAll(['id','date','shop','kind','url','no','memo','chk','chkDel','createdAt'])
          && d.keys().hasOnly(['id','date','shop','kind','url','no','memo','chk','chkDel','createdAt'])
          && d.id is string && d.id == lid
          && d.date is string && d.date.size() == 10
          && d.shop is string && d.shop.size() > 0 && d.shop.size() <= 60
          && (d.kind == '🤍' || d.kind == '릴스')
          && d.url is string && d.url.matches("^https://(www[.])?instagram[.]com/(p|reel|tv|share(/(p|reel|tv))?)/[A-Za-z0-9_-]+/$")
          && d.no is int && d.no >= 0
          && d.memo is string && d.memo.size() <= 300
          && d.chk is string && d.chkDel is string
          && d.createdAt is timestamp;
    }

    // ── 그날 참여 링크
    match /links/{lid} {
      allow read: if true;

      // 남기기
      allow create: if openNow()
                    && itemOk(request.resource.data, lid)
                    && request.resource.data.createdAt == request.time
                    && chkOk(request.resource.data.chk, lid, request.resource.data.shop);

      // 고치기 (구분만 바꾸는 경우 — 주소가 바뀌면 번호가 바뀌므로 새로 만들고 옛것을 지운다)
      allow update: if openNow()
                    && itemOk(request.resource.data, lid)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.shop == resource.data.shop
                    && request.resource.data.date == resource.data.date
                    && request.resource.data.chkDel == resource.data.chkDel
                    && chkOk(request.resource.data.chk, lid, resource.data.shop);

      // 지우기 — 본인 암호(남기는 시간 안) 또는 스태프(시간 상관없음)
      allow delete: if (openNow() && chkOk(resource.data.chkDel, lid, resource.data.shop))
                    || chkStaff(resource.data.chkDel, lid);
    }

    // ── 회원 4자리 암호 — 화면에서 읽을 수 없다. 처음 한 번만 만들고, 바꾸기는 스태프만
    match /pins/{safe} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['pin'])
                    && request.resource.data.pin is string
                    && request.resource.data.pin.matches("[0-9]{4}");
      allow update, delete: if getAfter(/databases/$(database)/documents/pinchk/$(safe)).data.op == 'pinset';
    }

    // ── 암호 확인용 문서 — 만들 때 암호를 대조하고, 링크 쓰기와 함께 쓰이며, 끝나면 지운다
    match /checks/{cid} {
      allow read: if false;
      allow create: if ( (request.resource.data.op == 'write' || request.resource.data.op == 'del' || request.resource.data.op == 'course')
                         && request.resource.data.keys().hasOnly(['op','id','shop','pin'])
                         && pinOk(request.resource.data.shop, request.resource.data.pin) )
                    || ( request.resource.data.op == 'staff'
                         && request.resource.data.keys().hasOnly(['op','id','pw'])
                         && request.resource.data.pw == '0423' );
      allow update: if false;
      allow delete: if true;
    }

    // ── 스태프 암호 바꾸기·비우기 표시 (운영 센터 비밀번호 확인용)
    match /pinchk/{safe} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['op','pin','pw'])
                    && request.resource.data.op == 'pinset'
                    && request.resource.data.pw == '0423'
                    && request.resource.data.pin.matches("^([0-9]{4})?$");
      allow update: if false;
      allow delete: if true;
    }

    // ── 파이어베이스 읽기 사용량 집계 (운영 센터 카드용) — 사이트가 직접 더한다
    match /stats/{day} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['reads'])
                    && request.resource.data.reads is int
                    && request.resource.data.reads >= 0
                    && request.resource.data.reads <= 2000;
      allow update: if request.resource.data.keys().hasOnly(['reads'])
                    && request.resource.data.reads is int
                    && request.resource.data.reads > resource.data.reads
                    && (request.resource.data.reads - resource.data.reads) <= 2000;
      allow delete: if false;
    }

    // ── 뷰티수강 채팅 — 방(대화방) 모양과 메시지 모양
    //    방번호 = 원장님 열쇠 + '_' + 고객 기기번호 (dia-chat.js 의 roomId 와 같음)
    function chatRoomOk(d, rid) {
      return d.keys().hasAll(['roomId','owner','nick','cust','custName','last','lastAt','lastFrom','unreadC','unreadI','createdAt'])
          && d.keys().hasOnly(['roomId','owner','nick','cust','custName','last','lastAt','lastFrom','unreadC','unreadI','createdAt'])
          && d.roomId is string && d.roomId == rid
          && d.owner is string && d.owner.size() > 0 && d.owner.size() <= 80
          && d.nick is string && d.nick.size() <= 80
          && d.cust is string && d.cust.size() >= 8 && d.cust.size() <= 60
          && d.custName is string && d.custName.size() <= 40
          && d.last is string && d.last.size() <= 300
          && d.lastFrom is string && (d.lastFrom == 'c' || d.lastFrom == 'i')
          && d.unreadC is int && d.unreadC >= 0 && d.unreadC <= 9999
          && d.unreadI is int && d.unreadI >= 0 && d.unreadI <= 9999
          && d.lastAt is timestamp && d.createdAt is timestamp;
    }

    // ── 뷰티수강 채팅 (수강찾기 카드 ↔ 원장님 마이페이지)
    match /chats/{rid} {
      allow read: if true;

      // 방 만들기 — 고객이 카드에서 처음 말을 걸 때 한 번
      allow create: if chatRoomOk(request.resource.data, rid)
                    && request.resource.data.createdAt == request.time;

      // 방 요약 고치기 (마지막 메시지·안 읽은 수·고객 이름) — 주인과 고객 번호는 못 바꿈
      allow update: if chatRoomOk(request.resource.data, rid)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.owner == resource.data.owner
                    && request.resource.data.cust == resource.data.cust;
      // 지우기 — 원장님·고객 모두 자기 목록에서 지울 수 있다(방 하나가 양쪽에서 사라진다)
      allow delete: if true;

      match /msgs/{mid} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['from','text','at'])
                      && request.resource.data.from is string
                      && (request.resource.data.from == 'c' || request.resource.data.from == 'i')
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 900
                      && request.resource.data.at is timestamp
                      && request.resource.data.at == request.time
                      && exists(/databases/$(database)/documents/chats/$(rid));
        allow update: if false;
        allow delete: if true;   // 방을 지울 때 메시지도 같이 지운다
      }
    }

    // ── 원장님 본인 뷰티수강 등록·수정 요청 (4자리 암호로 본인 확인 후 검토 대기 저장)
    //    승인·반려 및 실제 라이브 반영(courses)은 운영센터(op == 'staff')만 가능
    function chkCourse(cid, docId, shop) {
      return getAfter(/databases/$(database)/documents/checks/$(cid)).data.id == docId
          && getAfter(/databases/$(database)/documents/checks/$(cid)).data.shop == shop
          && getAfter(/databases/$(database)/documents/checks/$(cid)).data.op == 'course';
    }
    function courseReqOk(d, cid) {
      return d.keys().hasAll(['id','shop','status','action','name','insta','region','cat','insta_url','naver_url','home_url','benefit','intro','chk','updatedAt'])
          && d.keys().hasOnly(['id','shop','status','action','name','insta','region','cat','insta_url','naver_url','home_url','benefit','intro','chk','updatedAt'])
          && d.id is string && d.id == cid
          && d.shop is string && d.shop.size() > 0 && d.shop.size() <= 80
          && (d.status == 'pending' || d.status == 'approved' || d.status == 'rejected')
          && (d.action == 'save' || d.action == 'hide')
          && d.name is string && d.name.size() <= 80
          && d.insta is string && d.insta.size() <= 60
          && d.region is string && d.region.size() <= 40
          && d.cat is string && d.cat.size() <= 60
          && d.insta_url is string && d.insta_url.size() <= 200
          && d.naver_url is string && d.naver_url.size() <= 300
          && d.home_url is string && d.home_url.size() <= 300
          && d.benefit is string && d.benefit.size() <= 200
          && d.intro is string && d.intro.size() <= 400
          && d.chk is string
          && d.updatedAt is timestamp;
    }
    match /course_requests/{cid} {
      allow read: if true;
      allow create: if courseReqOk(request.resource.data, cid)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.updatedAt == request.time
                    && chkCourse(request.resource.data.chk, cid, request.resource.data.shop);
      allow update: if courseReqOk(request.resource.data, cid)
                    && request.resource.data.updatedAt == request.time
                    && (
                      (request.resource.data.status == 'pending'
                       && request.resource.data.shop == resource.data.shop
                       && chkCourse(request.resource.data.chk, cid, resource.data.shop))
                      ||
                      ((request.resource.data.status == 'approved' || request.resource.data.status == 'rejected')
                       && chkStaff(request.resource.data.chk, cid))
                    );
      allow delete: if false;
    }

    function courseOk(d, cid) {
      return d.keys().hasAll(['id','shop','name','insta','region','cat','insta_url','naver_url','home_url','benefit','intro','chk','updatedAt'])
          && d.keys().hasOnly(['id','shop','name','insta','region','cat','insta_url','naver_url','home_url','benefit','intro','chk','updatedAt'])
          && d.id is string && d.id == cid
          && d.shop is string && d.shop.size() > 0 && d.shop.size() <= 80
          && d.name is string && d.name.size() <= 80
          && d.insta is string && d.insta.size() <= 60
          && d.region is string && d.region.size() <= 40
          && d.cat is string && d.cat.size() <= 60
          && d.insta_url is string && d.insta_url.size() <= 200
          && d.naver_url is string && d.naver_url.size() <= 300
          && d.home_url is string && d.home_url.size() <= 300
          && d.benefit is string && d.benefit.size() <= 200
          && d.intro is string && d.intro.size() <= 400
          && d.chk is string
          && d.updatedAt is timestamp;
    }
    match /courses/{cid} {
      allow read: if true;
      allow create, update: if courseOk(request.resource.data, cid)
                            && request.resource.data.updatedAt == request.time
                            && chkStaff(request.resource.data.chk, cid);
      allow delete: if false;
    }

    // ── 운영 데이터 묶음 (meta/members: 명부·봉사·휴식, meta/invites: 지인 초대 추적)
    match /meta/{mid} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['data','chk','updatedAt'])
                            && request.resource.data.data is string
                            && request.resource.data.updatedAt == request.time
                            && chkStaff(request.resource.data.chk, mid);
      allow delete: if false;
    }

    // ── 뷰티수강 클릭 통계 (인기 탑 순 즉시 로딩)
    match /clicks/{cid} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count is int
                    && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count is int
                    && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // ── 기능 제안 / 건의함
    match /suggestions/{sid} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id','text','from','status','createdAt'])
                    && request.resource.data.keys().hasOnly(['id','text','from','status','createdAt'])
                    && request.resource.data.id is string && request.resource.data.id == sid
                    && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
                    && request.resource.data.from is string && request.resource.data.from.size() <= 60
                    && request.resource.data.status == 'open'
                    && request.resource.data.createdAt == request.time;
      allow update: if request.resource.data.keys().hasAll(['id','text','from','status','chk','createdAt','updatedAt'])
                    && request.resource.data.keys().hasOnly(['id','text','from','status','chk','createdAt','updatedAt'])
                    && (request.resource.data.status == 'open' || request.resource.data.status == 'done')
                    && request.resource.data.updatedAt == request.time
                    && chkStaff(request.resource.data.chk, sid);
      allow delete: if false;
    }

    // ── 아카데미 수강 상담 신청함 (index.html → 운영센터 확인)
    match /consults/{cid} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['id','name','phone','course','memo','status','createdAt'])
                    && request.resource.data.keys().hasOnly(['id','name','phone','course','memo','status','createdAt'])
                    && request.resource.data.id is string && request.resource.data.id == cid
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
                    && request.resource.data.phone is string && request.resource.data.phone.size() > 0 && request.resource.data.phone.size() <= 40
                    && request.resource.data.course is string && request.resource.data.course.size() <= 60
                    && request.resource.data.memo is string && request.resource.data.memo.size() <= 400
                    && request.resource.data.status == 'open'
                    && request.resource.data.createdAt == request.time;
      allow update: if request.resource.data.keys().hasAll(['id','name','phone','course','memo','status','chk','createdAt','updatedAt'])
                    && request.resource.data.keys().hasOnly(['id','name','phone','course','memo','status','chk','createdAt','updatedAt'])
                    && (request.resource.data.status == 'open' || request.resource.data.status == 'done')
                    && request.resource.data.updatedAt == request.time
                    && chkStaff(request.resource.data.chk, cid);
      allow delete: if false;
    }

    // ── 일일 방문·접속 통계 (dia / aca / crs)
    match /analytics/{day} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['dia','aca','crs'])
                            && (!('dia' in request.resource.data) || request.resource.data.dia is int)
                            && (!('aca' in request.resource.data) || request.resource.data.aca is int)
                            && (!('crs' in request.resource.data) || request.resource.data.crs is int);
      allow delete: if false;
    }

    // ── 품앗이 일일 이력 (pumasi_logs/{YYYY-MM-DD})
    match /pumasi_logs/{day} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['day','done','miss','bongsa','memo','chk','updatedAt'])
                            && request.resource.data.keys().hasOnly(['day','done','miss','bongsa','memo','chk','updatedAt'])
                            && request.resource.data.day is string && request.resource.data.day == day
                            && request.resource.data.done is string && request.resource.data.done.size() <= 1000
                            && request.resource.data.miss is string && request.resource.data.miss.size() <= 500
                            && request.resource.data.bongsa is string && request.resource.data.bongsa.size() <= 500
                            && request.resource.data.memo is string && request.resource.data.memo.size() <= 400
                            && request.resource.data.updatedAt == request.time
                            && chkStaff(request.resource.data.chk, day);
      allow delete: if false;
    }

    // ── 인스타 DM 현황판 (dm_leads/{lid})
    match /dm_leads/{lid} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id','handle','acct','status','memo','chk','updatedAt'])
                            && request.resource.data.keys().hasOnly(['id','handle','acct','status','memo','chk','updatedAt'])
                            && request.resource.data.id is string && request.resource.data.id == lid
                            && request.resource.data.handle is string && request.resource.data.handle.size() > 0 && request.resource.data.handle.size() <= 60
                            && request.resource.data.acct is string && request.resource.data.acct.size() <= 40
                            && (request.resource.data.status == 'sent' || request.resource.data.status == 'replied' || request.resource.data.status == 'joined' || request.resource.data.status == 'skip')
                            && request.resource.data.memo is string && request.resource.data.memo.size() <= 200
                            && request.resource.data.updatedAt == request.time
                            && chkStaff(request.resource.data.chk, lid);
      allow delete: if false;
    }

    // ── 그 밖의 모든 경로는 막는다
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
